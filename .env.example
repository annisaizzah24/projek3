# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=ganti-dengan-secret-acak
HOST=127.0.0.1
PORT=5000

# SQLite lokal digunakan secara default. Isi DATABASE_URL hanya jika memakai database lain.
# Contoh MySQL: DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/sociovault_db?charset=utf8mb4
